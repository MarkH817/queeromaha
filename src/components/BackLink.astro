---
import type { HTMLAttributes } from 'astro/types'
import { Icon } from 'astro-icon/components'

interface Props extends HTMLAttributes<'a'> {}
const { class: className, href = '/friends', ...attrs } = Astro.props
---

<a class:list={["back-link", className]} {href} {...attrs}>
  <Icon
    name="fa7-solid:arrow-left"
    width="1.25em"
    height="1.25em"
    aria-hidden="true"
  />
  <slot>Go Back to the homepage</slot>
</a>
<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    color: #6d28d9;
    font-weight: 600;
    text-decoration: none;
    @media (prefers-color-scheme: dark) {
      color: var(--dm-glow);
    }
    &:hover,
    &:focus {
      text-decoration: underline;
    }
  }
</style>
