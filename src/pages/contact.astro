---
import { Icon } from 'astro-icon/components'
import BackLink from '#components/BackLink.astro'
import Card from '#components/ui/Card.astro'
import Base from '#layouts/Base.astro'
---

<Base
  title="Contact"
  description="Contact an admin / maintainer at QueerOmaha.net."
>
  <article class="legal-page">
    <Card class="legal-card">
      <h2 slot="header">
        <Icon
          name="fa7-regular:envelope"
          width="1.25em"
          height="1.25em"
          aria-hidden="true"
        />
        Contact
      </h2>

      <form
        id="contactForm"
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="contact-honeypot">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>
        <label class="contact-label" for="contactEmail">
          Your email
        </label>
        <input
          id="contactEmail"
          class="contact-input"
          type="email"
          name="email"
          required
          autocomplete="email"
        />
        <label class="contact-label" for="contactMessage">
          Message
        </label>
        <textarea
          id="contactMessage"
          class="contact-textarea"
          name="message"
          required
          rows="5"
        ></textarea>
        <button class="contact-submit" type="submit">
          <Icon
            name="fa7-regular:paper-plane"
            width="1.25em"
            height="1.25em"
            aria-hidden="true"
          />
          Send
        </button>
      </form>

      <p>
        <BackLink>Go Back to the directory</BackLink>
      </p>
    </Card>
  </article>
</Base>

<script>
  import "../scripts/contactForm";
</script>
