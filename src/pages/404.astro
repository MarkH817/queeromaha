---
import { Icon } from 'astro-icon/components'
import BackLink from '#components/BackLink.astro'
import Card from '#components/ui/Card.astro'
import Base from '#layouts/Base.astro'

const redirectSeconds = 8
---

<Base
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Here's how to get back to the Queer Omaha directory."
  refresh={{ seconds: redirectSeconds, url: "/friends" }}
>
  <section class="not-found" aria-label="Page not found">
    <Card class="not-found-card">
      <h2 slot="header">
        <Icon
          name="fa7-regular:compass"
          width="1.25em"
          height="1.25em"
          aria-hidden="true"
        />
        This page wandered off
      </h2>
      <p>
        We couldn't find that page. It may have moved, been renamed, or never
        existed.
      </p>
      <p>
        <BackLink class="not-found-cta" data-notfound-link>
          Back to the directory
        </BackLink>
      </p>
      <p
        class="not-found-countdown"
        data-notfound-countdown
        aria-live="polite"
        hidden
      >
        Taking you back to the directory in <span data-notfound-seconds
          >{redirectSeconds}</span
        >…
      </p>
    </Card>
  </section>
</Base>

<script>
  import "../scripts/notFoundRedirect";
</script>

<style>
  .not-found {
    display: flex;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .not-found-card {
    max-width: 32rem;
    width: 100%;

    h2 {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
      font-size: 1.3rem;
    }
  }

  .not-found-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    background: #6d28d9;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.15s;
    &,
    &:hover,
    &:focus {
      color: #fff;
    }
    &:hover,
    &:focus {
      background: #5b21b6;
      text-decoration: none;
    }
    @media (prefers-color-scheme: dark) {
      background: var(--dm-glow);
      &,
      &:hover,
      &:focus {
        color: var(--dm-nightfall);
      }
      &:hover,
      &:focus {
        background: var(--dm-moonlight);
      }
    }
  }

  .not-found-countdown {
    color: #6b6b6b;
    font-size: 0.9rem;
    @media (prefers-color-scheme: dark) {
      color: var(--dm-haze);
    }
  }
</style>
